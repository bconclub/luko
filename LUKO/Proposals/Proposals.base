filters:
  and:
    - 'category == "proposal"'
properties:
  file.name:
    displayName: Proposal
  client:
    displayName: Client
  amount:
    displayName: Amount (₹)
  status:
    displayName: Status
  sent:
    displayName: Sent
views:
  - type: table
    name: All proposals
    order:
      - file.name
      - client
      - amount
      - status
      - sent
  - type: table
    name: In play
    filters:
      or:
        - 'status == "sent"'
        - 'status == "discussing"'
    order:
      - file.name
      - client
      - amount
      - sent
