# Twin health checker — per-brand Supabase credentials (service role, read-only use)
# Copy to .env, fill the *_SERVICE_KEY values, then: chmod 600 .env — never commit.
# Where to find each key: Supabase dashboard → project → Settings → API → service_role
# (or Vercel → the brand's project → Settings → Environment Variables → SUPABASE_SERVICE_ROLE_KEY)

# bcon (LIVE)
BCON_SUPABASE_URL=https://yvkauaiyranysldubnqv.supabase.co
BCON_SUPABASE_SERVICE_KEY=

# windchasers (LIVE)
WINDCHASERS_SUPABASE_URL=https://flwsyaejscxmattmiskp.supabase.co
WINDCHASERS_SUPABASE_SERVICE_KEY=

# lokazen (LIVE)
LOKAZEN_SUPABASE_URL=https://egwwpngaoaeqemieawcx.supabase.co
LOKAZEN_SUPABASE_SERVICE_KEY=

# pop (TESTING)
POP_SUPABASE_URL=https://jlheidosabefyszmkxrp.supabase.co
POP_SUPABASE_SERVICE_KEY=

# Alerts — fill ONE of these and failing checks get pinged automatically.
# Slack: create an incoming webhook (or reuse a brand's SLACK_WEBHOOK_URL pointed at #proxe-issues)
ALERT_SLACK_WEBHOOK_URL=
# Telegram: reuse the existing team bot (TELEGRAM_BOT_TOKEN + the group chat id)
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- LUKO signals (this system, not the dormant PROXe checker above) ---
# Telegram bot for important signals. Create a bot via @BotFather, get the token,
# then message the bot once and hit https://api.telegram.org/bot<token>/getUpdates
# to find your chat id.
LUKO_TELEGRAM_BOT_TOKEN=
LUKO_TELEGRAM_CHAT_ID=
